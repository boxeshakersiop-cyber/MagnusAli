{
  "manifest_version": 3,
  "name": "MagnusAli ChessCOACH — Adaptive 4000",
  "short_name": "MagnusAli ChessCOACH",
  "version": "16.1.0",
  "description": "Персональный шахматный тренер MagnusAli ChessCOACH для Lichess и Chess.com: Stockfish 19, адаптивная сила до 4000 ELO и живой интерфейс.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://*.lichess.org/*",
    "https://chess.com/*",
    "https://*.chess.com/*",
    "https://tablebase.lichess.ovh/*",
    "https://explorer.lichess.ovh/*",
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*"
      ],
      "js": [
        "content/main-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*"
      ],
      "js": [
        "lib/magnusali-core.js",
        "lib/openings.js",
        "lib/explainer.js",
        "lib/phonk-fx.js",
        "lib/script-api.js",
        "content/content.js",
        "scripts/sample.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chess.com/*",
        "https://*.chess.com/*"
      ],
      "js": [
        "lib/magnusali-core.js",
        "lib/openings.js",
        "lib/explainer.js",
        "lib/phonk-fx.js",
        "lib/script-api.js",
        "content/chesscom.js",
        "scripts/sample.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "content/*",
        "scripts/*"
      ],
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*",
        "https://chess.com/*",
        "https://*.chess.com/*"
      ]
    }
  ]
}
