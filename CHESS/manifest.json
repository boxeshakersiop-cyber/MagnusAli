{
  "manifest_version": 3,
  "name": "ChessCoach REWORK — Vision HUD & Tactical Core",
  "version": "15.3.1",
  "description": "Интерактивный шахматный тренер и анализатор для Lichess и Chess.com с поддержкой пользовательских скриптов (CC Script API v2.0).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://*.lichess.org/*",
    "https://chess.com/*",
    "https://*.chess.com/*",
    "https://tablebase.lichess.ovh/*",
    "https://explorer.lichess.ovh/*",
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*"
      ],
      "js": [
        "content/main-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*"
      ],
      "js": [
        "lib/openings.js",
        "lib/explainer.js",
        "lib/phonk-fx.js",
        "lib/script-api.js",
        "content/content.js",
        "scripts/sample.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chess.com/*",
        "https://*.chess.com/*"
      ],
      "js": [
        "lib/openings.js",
        "lib/explainer.js",
        "lib/phonk-fx.js",
        "lib/script-api.js",
        "content/chesscom.js",
        "scripts/sample.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "content/*",
        "scripts/*"
      ],
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*",
        "https://chess.com/*",
        "https://*.chess.com/*"
      ]
    }
  ]
}